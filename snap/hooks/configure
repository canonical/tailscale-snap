#!/bin/sh -e

check_boolean() {
    # Normalise and validate boolean value
    local value="$(snapctl get "$1" | tr '[:upper:]' '[:lower:]')"
    if [ -n "$value" ] && [ "$value" != "true" ] && [ "$value" != "false" ]; then
        echo "$1 must be 'true' or 'false', got: '${value}'" >&2
        exit 1
    fi
    # Write back normalised value if it exists
    if [ -n "$value" ]; then
        snapctl set "$1"="$value"
    fi
}

check_boolean no-logs-no-support
check_boolean encrypt-state
check_boolean hardware-attestation

# Restart tailscaled service to apply new configuration
if snapctl services tailscale.tailscaled | grep -q "active"; then
    snapctl restart tailscale.tailscaled
fi
